<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".AetherApp"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NajiAethers"
        android:localeConfig="@xml/locales_config">

        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <intent-filter>
                <action android:name="androidx.appcompat.app.AppLocalesMetadataHolderService" />
            </intent-filter>
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|locale|layoutDirection"
            android:theme="@style/Theme.NajiAethers"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".vpn.AetherVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs the Aether censorship-circumvention VPN tunnel while active" />
        </service>

        <service
            android:name=".vpn.AetherTileService"
            android:exported="true"
            android:icon="@drawable/ic_notification"
            android:label="@string/qs_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name=".widget.AetherWidgetProvider"
            android:exported="false"
            android:label="@string/widget_simple_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/aether_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.AetherWidgetLargeProvider"
            android:exported="false"
            android:label="@string/widget_advanced_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/aether_widget_large_info" />
        </receiver>

        <activity
            android:name=".CrashReportActivity"
            android:exported="false"
            android:theme="@style/Theme.NajiAethers" />

        <activity
            android:name=".LiveGraphActivity"
            android:exported="false"
            android:theme="@style/Theme.NajiAethers" />

        <activity
            android:name=".UsageCalendarActivity"
            android:exported="false"
            android:theme="@style/Theme.NajiAethers" />

        <activity
            android:name=".ChangelogActivity"
            android:exported="false"
            android:theme="@style/Theme.NajiAethers" />

        <activity
            android:name=".EndpointHistoryActivity"
            android:exported="false"
            android:theme="@style/Theme.NajiAethers" />

    </application>
</manifest>